---
import Layout from "../layouts/Layout.astro";

import WorkTimeline from "../components/WorkTimeline.astro";
import SomeProjects from "../components/SomeProjects.astro";
import Skills from "../components/Skills.astro";
import AboutMe from "../components/AboutMe.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
---

<Layout title="fjmg84">
  <main class="flex flex-col relative w-full">
    <Hero />

    <Marquee />

    <div
      id="content"
      class="px-5 py-24 md:py-32 md:px-0 w-full flex flex-col items-center"
    >
      <div
        class="flex flex-col gap-20 md:gap-28 items-stretch w-full md:w-[80%] lg:w-[70%] xl:w-[60%]"
      >
        <AboutMe />

        <WorkTimeline />

        <Skills />

        <SomeProjects />

        <Footer />
      </div>
    </div>
  </main>
</Layout>
