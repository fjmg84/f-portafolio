---
const { title, eyebrow, subtitle } = Astro.props;
---

<div class="flex flex-col gap-5">
  {
    eyebrow && (
      <span class="inline-flex items-center gap-3 w-fit text-[0.8rem] font-bold tracking-eyebrow uppercase text-accent">
        <span
          class="w-9 h-0.5 rounded-full bg-gradient-bar"
          aria-hidden="true"
        />
        {eyebrow}
      </span>
    )
  }
  <h2
    class="text-title-sm font-extrabold tracking-tight-tight leading-none bg-gradient-title bg-clip-text text-transparent"
  >
    {title}
  </h2>
  {
    subtitle && (
      <p class="text-subtitle-sm font-light leading-[1.5] text-white/55 max-w-[44rem]">
        {subtitle}
      </p>
    )
  }
</div>
