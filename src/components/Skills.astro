---
import { skills } from "../data/data.json";
import TitlePage from "./TitlePage.astro";

const categoryLabels: Record<string, string> = {
  core: "Core",
  "frameworks-libraries": "Frameworks/Libraries",
  stylized: "Stylized",
  "backend-tools": "Backend & Tools",
};

const categoryOrder = [
  "core",
  "frameworks-libraries",
  "stylized",
  "backend-tools",
];

const groupedSkills = skills.reduce<Record<string, typeof skills>>(
  (acc, skill) => {
    const key = skill.category || "other";
    if (!acc[key]) {
      acc[key] = [];
    }

    acc[key].push(skill);
    return acc;
  },
  {},
);

const orderedCategories = [
  ...categoryOrder.filter((category) => groupedSkills[category]?.length),
  ...Object.keys(groupedSkills)
    .filter((category) => !categoryOrder.includes(category))
    .sort((a, b) => a.localeCompare(b)),
];
---

<section class="flex flex-col gap-8 reveal">
  <TitlePage
    eyebrow="Toolbox"
    title="Skills"
    subtitle="The technologies I reach for to ship fast, scalable, production-grade products."
  />

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 stagger-reveal">
    {
      orderedCategories.map((category, index) => {
        const categorySkills = groupedSkills[category].sort((a, b) =>
          a.name.localeCompare(b.name),
        );

        return (
          <section class="relative flex flex-col p-[1.75rem] rounded-[1rem] border border-white/[0.08] bg-[linear-gradient(160deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] overflow-hidden transition-all duration-[300ms] ease group hover:border-accent/35 hover:-translate-y-1">
            <div class="absolute inset-0 bg-[radial-gradient(120%_120%_at_0%_0%,rgba(168,85,247,0.12),transparent_55%)] opacity-0 transition-opacity duration-[300ms] ease pointer-events-none group-hover:opacity-100" />
            <div class="relative z-10 flex items-center gap-3 mb-5">
              <span class="text-[0.75rem] font-bold tracking-[0.1em] text-accent font-variant-numeric tabular-nums">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="m-0 text-[0.8rem] font-bold tracking-[0.12em] uppercase text-white/85">
                {categoryLabels[category] || category}
              </h3>
            </div>

            <ul class="relative z-10 flex flex-wrap gap-[0.625rem]">
              {categorySkills.map((skill) => {
                const skillColor =
                  skill.bgColor &&
                  skill.bgColor !== "white" &&
                  skill.bgColor !== "#000000"
                    ? skill.bgColor
                    : "#a855f7";
                return (
                  <li
                    class="inline-flex items-center gap-[0.5rem] px-[0.85rem] py-[0.4rem] text-[0.85rem] font-light text-white/75 bg-white/[0.04] border border-white/[0.08] rounded-full cursor-default transition-all duration-[250ms] ease hover:text-white hover:-translate-y-0.5"
                    style={`--skill-color: ${skillColor};`}
                  >
                    <span
                      class="w-[7px] h-[7px] rounded-full transition-transform duration-[250ms] ease hover:scale-[1.3]"
                      style={`background: var(--skill-color); box-shadow: 0 0 8px var(--skill-color);`}
                    />
                    {skill.name}
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })
    }
  </div>
</section>
